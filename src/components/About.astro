---
---
<section id="about">
  <div class="container">
    <p class="section-label">about</p>

    <div class="about-main">
      <div class="about-photo">
        <img src="/images/nehemiah.jpeg" alt="Nehemiah" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
        <div class="photo-placeholder" aria-hidden="true">N</div>
      </div>
      <div class="about-content">
        <h2>Engineering the systems</br>behind great software</h2>
        <p>
          I'm Nehemiah, Software Engineer focused on building reliable software and infrastructure. I turn complex engineering problems into simple, automated systems—from backend services, to deployment, and observability.
        </p>
      </div>
    </div>

    <div class="about-stats">
      <div class="stat-card">
        <span class="stat-num">Backend</span>
        <span class="stat-label">Designing scalable APIs and distributed services</span>
      </div>
      <div class="stat-card">
        <span class="stat-num">Platform</span>
        <span class="stat-label">Building tooling and infrastructure that accelerates development</span>
      </div>
      <div class="stat-card">
        <span class="stat-num">Cloud</span>
        <span class="stat-label">Automating deployments and operating reliable production systems</span>
      </div>
    </div>
    </div>
  </div>
</section>

<style>
  #about {
  padding-top: 2rem;
}

.about-main {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: 2.5rem;
  align-items: start;
  margin-top: 2rem;
}

.about-photo {
  position: relative;
  width: 180px;
  height: 180px;
  flex-shrink: 0;
}
.about-photo img {
  width: 180px;
  height: 180px;
  border-radius: var(--radius-lg);
  object-fit: cover;
  object-position: top;
  border: 1px solid var(--border);
  display: block;
}
.photo-placeholder {
  display: none;
  width: 180px;
  height: 180px;
  border-radius: var(--radius-lg);
  background: var(--accent-light);
  border: 1px solid var(--purple-100);
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  font-size: 3rem;
  font-weight: 500;
  color: var(--accent);
}

.about-content h2 {
  margin-bottom: 1rem;
}
.about-content p {
  color: var(--text-secondary);
  font-size: 0.975rem;
  line-height: 1.75;
  margin-bottom: 1rem;
}
.about-content p:last-child {
  margin-bottom: 0;
}

.about-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 2.5rem;
}
.stat-card {
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 1rem;
  display: flex;
  flex-direction: column;
}
.stat-num {
  font-family: var(--font-mono);
  font-size: 1.3rem;
  font-weight: 500;
  color: var(--accent);
  line-height: 1.2;
}
.stat-label {
  font-size: 0.72rem;
  color: var(--text-muted);
  margin-top: 3px;
}

@media (max-width: 640px) {
  .about-main { grid-template-columns: 1fr; gap: 1.5rem; }
  .about-photo, .about-photo img, .photo-placeholder { width: 100px; height: 100px; }
  .about-stats { grid-template-columns: 1fr; }
}
</style>